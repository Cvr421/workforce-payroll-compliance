# Frontend (Vue 3 + Vite) .gitignore
# =================================

# Dependencies
node_modules/

# Build output
dist/
build/

# Vite cache
.vite/

# Environment files (keep .env.example)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# IDE/Editor
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Testing
coverage/

# TypeScript cache
*.tsbuildinfo

# Editor backup files
*.bak
*.orig

# IDE project files
*.iml
*.ipr
*.iws

# Local certificates
*.pem
*.key
*.crt