DATABASE_URL=postgres://complylite:complylite@localhost:5432/complylite?sslmode=disable
REDIS_URL=redis://localhost:6379
JWT_SECRET=dev-secret-change-in-production-at-least-32-bytes-long
JWT_ISSUER=complylite
JWT_AUDIENCE=complylite-api
PORT=8080
LOG_LEVEL=debug
CORS_ALLOWED_ORIGINS=http://localhost:5173
STORAGE_DIR=/tmp/complylite-storage
DB_MAX_CONNS=10
WORKER_CONCURRENCY=4
WORKER_POLL_INTERVAL=2s
JOB_STALE_AFTER=5m
SEED_PASSWORD=DemoPassword123
