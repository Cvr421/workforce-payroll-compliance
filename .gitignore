# ComplyHub .gitignore
# =======================
# This file covers Go, Vue.js/Vite, Docker, and common development artifacts.

# --- Go ---
# Binaries and build artifacts
/api
/worker
/seed
/migrate
*.exe
*.dll
*.so
*.dylib

# Test output
*.test
*.out
coverage.out
coverage.html

# Dependency directories (use go mod vendor if needed)
vendor/

# Go workspace
go.work

# --- Frontend (Vue 3 + Vite) ---
# Dependencies
node_modules/

# Build output
dist/
build/

# Vite cache
.vite/

# Environment files (keep .env.example)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# IDE/Editor
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Testing
coverage/

# TypeScript cache
*.tsbuildinfo

# --- Docker ---
# Docker Compose override files
docker-compose.override.yml
docker-compose.local.yml

# --- Backend specific ---
# Environment files
backend/.env
backend/.env.local

# Compiled binaries (from Makefile)
backend/api
backend/worker
backend/seed
backend/migrate

# --- Database ---
# SQLite (if used locally)
*.db
*.sqlite
*.sqlite3

# --- Build/Prompt documentation (local only) ---
BUild_application.md
ComplyHub_Build_Prompt.md
PROGRESS.md
# --- Misc ---
# Temporary files
*.tmp
*.temp
.tmp/
temp/

# Editor backup files
*~
*.bak
*.orig

# IDE project files
*.iml
*.ipr
*.iws

# VS Code (optional - uncomment if you want to ignore user settings)
# .vscode/settings.json

# --- CI/CD ---
# GitHub Actions workflow runs
.github/workflows/*.log

# --- Documentation ---
# Generated docs
docs/generated/

# --- Local development ---
# Local docker volumes
volumes/

# Local certificates
*.pem
*.key
*.crt